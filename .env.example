# Root .env for docker-compose (optional).
# Copy this file to `.env` at the repo root and adjust values as needed.
# All variables below have sensible defaults, so `docker compose up` works
# out of the box without a .env file.

# Backend
NODE_ENV=development
JWT_SECRET=change_this_to_a_strong_random_secret
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# Google OAuth (optional - leave empty to skip Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email / SMTP (optional - falls back to proxy/console logging when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PaySphere <no-reply@paysphere.com>"
EMAIL_PROXY_SECRET=

# Frontend
VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=

# AWS S3 object storage (required for uploaded files and persisted PDF exports)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Prefer IAM roles / workload identity in deployed environments.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
